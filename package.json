{
  "name": "cloak",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build",
    "start": "node server.mjs",
    "test": "node --test test-ui/*.test.mjs",
    "format": "prettier --write src index.html server.mjs vite.config.ts tsconfig.json test-ui",
    "format:check": "prettier --check src index.html server.mjs vite.config.ts tsconfig.json test-ui",
    "preview": "vite preview --host 0.0.0.0"
  },
  "dependencies": { "lucide-react": "^0.468.0", "react": "^19.0.0", "react-dom": "^19.0.0", "viem": "^2.21.0" },
  "devDependencies": { "@types/react": "^19.0.0", "@types/react-dom": "^19.0.0", "prettier": "^3.4.2", "typescript": "^5.7.2", "vite": "^6.0.5" }
}
